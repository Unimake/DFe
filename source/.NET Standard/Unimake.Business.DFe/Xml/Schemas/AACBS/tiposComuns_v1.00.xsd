<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.unimake.com.br/dfe/aacbs" targetNamespace="http://www.unimake.com.br/dfe/aacbs" elementFormDefault="qualified" attributeFormDefault="unqualified">
  <xs:simpleType name="VersaoXML"><xs:restriction base="xs:string"><xs:enumeration value="1.00"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="TextoNaoVazio"><xs:restriction base="xs:string"><xs:minLength value="1"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Identificacao8"><xs:restriction base="xs:string"><xs:length value="8"/><xs:pattern value="[0-9]{8}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="Identificacao14"><xs:restriction base="xs:string"><xs:length value="14"/><xs:pattern value="[0-9]{14}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="IdentificacaoConsumidor"><xs:union><xs:simpleType><xs:restriction base="xs:string"><xs:length value="11"/><xs:pattern value="[0-9]{11}"/></xs:restriction></xs:simpleType><xs:simpleType><xs:restriction base="xs:string"><xs:length value="14"/><xs:pattern value="[0-9]{14}"/></xs:restriction></xs:simpleType></xs:union></xs:simpleType>
  <xs:simpleType name="PeriodoApuracao"><xs:restriction base="xs:string"><xs:length value="7"/><xs:pattern value="(0[1-9]|1[0-2])/[0-9]{4}"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="ValorMonetario18_2"><xs:restriction base="xs:decimal"><xs:totalDigits value="18"/><xs:fractionDigits value="2"/><xs:pattern value="[+-]?([0-9]+(\.[0-9]{0,2}0*)?|\.[0-9]{1,2}0*)"/><xs:minInclusive value="-9999999999999999.99"/><xs:maxInclusive value="9999999999999999.99"/></xs:restriction></xs:simpleType>
  <xs:simpleType name="DataCivil"><xs:restriction base="xs:date"><xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}"/></xs:restriction></xs:simpleType>
  <!-- Validação lexical sem conversão CLR que arredonde frações sub-tick.
       Calendário, fuso e projeção truncada são verificados por AACBSValidator. -->
  <xs:simpleType name="InstanteComFuso"><xs:restriction base="xs:string"><xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})"/></xs:restriction></xs:simpleType>
  <xs:complexType name="ErroLocalTipo"><xs:sequence><xs:element name="codigo"><xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="SEM_RETORNO"/></xs:restriction></xs:simpleType></xs:element><xs:element name="mensagem" type="TextoNaoVazio"/></xs:sequence></xs:complexType>
</xs:schema>
