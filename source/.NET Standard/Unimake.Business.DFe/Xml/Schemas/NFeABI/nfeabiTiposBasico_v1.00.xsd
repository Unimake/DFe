<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" xmlns="http://www.portalfiscal.inf.br/nfeabi" targetNamespace="http://www.portalfiscal.inf.br/nfeabi" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:import namespace="http://www.w3.org/2000/09/xmldsig#" schemaLocation="xmldsig-core-schema_v1.01.xsd"/>
	<xs:include schemaLocation="tiposGeralNFeABI_v1.00.xsd"/>
	<xs:simpleType name="TDec_0304">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="0|0\.[0-9]{1,4}|[1-9][0-9]{0,2}(\.[0-9]{1,4})?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TDec_0302_04">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="0|0\.[0-9]{2,4}|[1-9][0-9]{0,2}(\.[0-9]{2,4})?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TDec_0702">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="0|0\.[0-9]{2}|[1-9][0-9]{0,6}(\.[0-9]{2})?"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TChNFeABI">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:length value="44"/>
			<xs:pattern value="(1[1-7]|2[1-9]|3[1-3]|35|4[1-3]|5[0-3])[0-9]{4}[A-Z0-9]{12}[0-9]{26}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TDate">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TVerNFeABI">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:pattern value="[0-9]{1,2}\.[0-9]{2}"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="TEmail">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
			<xs:minLength value="6"/>
			<xs:maxLength value="60"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="TEndereco">
		<xs:annotation>
			<xs:documentation>Tipo comum para endereço da NF-e ABI</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="xLgr">
				<xs:simpleType>
					<xs:restriction base="TString">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="2"/>
						<xs:maxLength value="60"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="nro">
				<xs:simpleType>
					<xs:restriction base="TString">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="1"/>
						<xs:maxLength value="60"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="xCpl" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="TString">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="1"/>
						<xs:maxLength value="60"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="xBairro" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="TString">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="2"/>
						<xs:maxLength value="60"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="cMun">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="7"/>
						<xs:maxLength value="7"/>
						<xs:pattern value="[0-9]{7}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="xMun">
				<xs:simpleType>
					<xs:restriction base="TString">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="2"/>
						<xs:maxLength value="60"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="UF">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="2"/>
						<xs:maxLength value="2"/>
						<xs:pattern value="[A-Z]{2}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="CEP" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="8"/>
						<xs:maxLength value="8"/>
						<xs:pattern value="[0-9]{8}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="cPais" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="2"/>
						<xs:maxLength value="4"/>
						<xs:pattern value="[0-9]{2,4}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="xPais" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="TString">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="1"/>
						<xs:maxLength value="60"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="fone" minOccurs="0">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="6"/>
						<xs:maxLength value="14"/>
						<xs:pattern value="[0-9]{6,14}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TGIntermedCorret">
		<xs:sequence>
			<xs:choice>
				<xs:element name="CNPJ" type="TCnpj"/>
				<xs:element name="CPF" type="TCpf"/>
			</xs:choice>
			<xs:element name="xNome">
				<xs:simpleType>
					<xs:restriction base="TString">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="2"/>
						<xs:maxLength value="60"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="vCorretagem" type="TDec_1302"/>
		</xs:sequence>
		<xs:attribute name="nCorretagem" use="required">
					<xs:simpleType>

				<xs:restriction base="xs:string">
					<xs:pattern value="[1-9]|[1-9][0-9]"/>
				</xs:restriction>
					</xs:simpleType>
		</xs:attribute>
	</xs:complexType>
	<xs:complexType name="TGRed">
		<xs:sequence>
			<xs:element name="pRedAliq" type="TDec_0304"/>
			<xs:element name="pAliqEfet" type="TDec_0304"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TGIBSUF">
		<xs:sequence>
			<xs:element name="pIBSUF" type="TDec_0304"/>
			<xs:element name="gRed" type="TGRed"/>
			<xs:element name="vIBSUF" type="TDec_1302"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TGIBSMun">
		<xs:sequence>
			<xs:element name="pIBSMun" type="TDec_0304"/>
			<xs:element name="gRed" type="TGRed"/>
			<xs:element name="vIBSMun" type="TDec_1302"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TGCBS">
		<xs:sequence>
			<xs:element name="pCBS" type="TDec_0304"/>
			<xs:element name="gRed" type="TGRed"/>
			<xs:element name="vCBS" type="TDec_1302"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TGTribCompraGov">
		<xs:sequence>
			<xs:element name="pAliqIBSUF" type="TDec_0304"/>
			<xs:element name="vTribIBSUF" type="TDec_1302"/>
			<xs:element name="pAliqIBSMun" type="TDec_0304"/>
			<xs:element name="vTribIBSMun" type="TDec_1302"/>
			<xs:element name="pAliqCBS" type="TDec_0304"/>
			<xs:element name="vTribCBS" type="TDec_1302"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TGIBSCBS">
		<xs:sequence>
			<xs:element name="vOperacIndiv" type="TDec_1302"/>
			<xs:element name="vTornaIndiv" type="TDec_1302" minOccurs="0"/>
			<xs:element name="vRedAjusteIndiv" type="TDec_1302" minOccurs="0"/>
			<xs:element name="vRedSocialIndiv" type="TDec_1302" minOccurs="0"/>
			<xs:element name="vBC" type="TDec_1302"/>
			<xs:element name="gIBSUF" type="TGIBSUF"/>
			<xs:element name="gIBSMun" type="TGIBSMun"/>
			<xs:element name="gCBS" type="TGCBS"/>
			<xs:element name="gTribCompraGov" type="TGTribCompraGov" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TGCompraGov">
		<xs:sequence>
			<xs:element name="tpEnteGov">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:pattern value="[1-4]"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="pRedutor" type="TDec_0302_04"/>
			<xs:element name="tpOperGov">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:pattern value="[1-2]"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TGEstornoCred">
		<xs:sequence>
			<xs:element name="vIBSEstCred" type="TDec_1302"/>
			<xs:element name="vCBSEstCred" type="TDec_1302"/>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="TIBSCBS">
		<xs:sequence>
			<xs:element name="CST">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="3"/>
						<xs:maxLength value="3"/>
						<xs:pattern value="[0-9]{3}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="cClassTrib">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="6"/>
						<xs:maxLength value="6"/>
						<xs:pattern value="[0-9]{6}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="gIBSCBS" type="TGIBSCBS" minOccurs="0"/>
			<xs:element name="gEstornoCred" type="TGEstornoCred" minOccurs="0"/>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="TProtNFeABI">
		<xs:annotation>
			<xs:documentation>Tipo Protocolo de status resultado do processamento da NF-e ABI (Modelo 77)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="infProt">
				<xs:annotation>
					<xs:documentation>Dados do protocolo de status</xs:documentation>
				</xs:annotation>
				<xs:complexType>
					<xs:sequence>
						<xs:element name="tpAmb" type="TAmb">
							<xs:annotation>
								<xs:documentation>Identificação do Ambiente: 1=Produção / 2=Homologação</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="verAplic">
							<xs:annotation>
								<xs:documentation>Versão do Aplicativo que processou a NF-e ABI</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="TString">
									<xs:minLength value="1"/>
									<xs:maxLength value="20"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="chNFeABI" type="TChNFeABI">
							<xs:annotation>
								<xs:documentation>Chave de acesso da NF-e ABI</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="dhRecbto" type="TDateTimeUTC">
							<xs:annotation>
								<xs:documentation>Data e hora de processamento, no formato AAAA-MM-DDTHH:MM:SSTZD</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="nProt" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Número do Protocolo de Status da NF-e ABI</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:whiteSpace value="preserve"/>
									<xs:pattern value="[0-9]{15}"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="digVal" type="ds:DigestValueType" minOccurs="0">
							<xs:annotation>
								<xs:documentation>Digest Value da NF-e ABI processada. Utilizado para conferir a integridade da NF-e ABI original.</xs:documentation>
							</xs:annotation>
						</xs:element>
						<xs:element name="cStat">
							<xs:annotation>
								<xs:documentation>Código do status da NF-e ABI</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="xs:string">
									<xs:whiteSpace value="preserve"/>
									<xs:pattern value="[0-9]{3}"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
						<xs:element name="xMotivo">
							<xs:annotation>
								<xs:documentation>Descrição literal do status da NF-e ABI</xs:documentation>
							</xs:annotation>
							<xs:simpleType>
								<xs:restriction base="TString">
									<xs:minLength value="1"/>
									<xs:maxLength value="255"/>
								</xs:restriction>
							</xs:simpleType>
						</xs:element>
					</xs:sequence>
					<xs:attribute name="Id" type="xs:ID" use="optional"/>
				</xs:complexType>
			</xs:element>
			<xs:element ref="ds:Signature" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="versao" type="TVerNFeABI" use="required"/>
	</xs:complexType>
	<xs:complexType name="TRetNFeABI">
		<xs:annotation>
			<xs:documentation>Tipo Retorno do Pedido de Autorização de NF-e ABI</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="tpAmb" type="TAmb">
				<xs:annotation>
					<xs:documentation>Identificação do Ambiente: 1=Produção / 2=Homologação</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="verAplic">
				<xs:annotation>
					<xs:documentation>Versão do Aplicativo que recebeu a NF-e ABI</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="TString">
						<xs:minLength value="1"/>
						<xs:maxLength value="20"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="cStat">
				<xs:annotation>
					<xs:documentation>Código do status da resposta</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:pattern value="[0-9]{3}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="xMotivo">
				<xs:annotation>
					<xs:documentation>Descrição literal do status do retorno</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="TString">
						<xs:minLength value="1"/>
						<xs:maxLength value="255"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="cUF" type="TCodUfIBGE">
				<xs:annotation>
					<xs:documentation>Código da UF que atendeu a solicitação</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="dhRecbto" type="TDateTimeUTC">
				<xs:annotation>
					<xs:documentation>Data e hora do processamento. Formato: AAAA-MM-DDThh:mm:ssTZD (UTC)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="protNFeABI" type="TProtNFeABI" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Dados do Protocolo de recebimento da NF-e ABI</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
		<xs:attribute name="versao" type="TVerNFeABI" use="required"/>
	</xs:complexType>
</xs:schema>