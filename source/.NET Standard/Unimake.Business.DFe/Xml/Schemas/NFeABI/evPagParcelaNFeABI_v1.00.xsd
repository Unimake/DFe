<?xml version="1.0" encoding="UTF-8"?>
<!-- Schema XML de validação do Evento de Pagamento de Parcela da NF-e ABI -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.portalfiscal.inf.br/nfeabi" xmlns:ds="http://www.w3.org/2000/09/xmldsig#" targetNamespace="http://www.portalfiscal.inf.br/nfeabi" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:include schemaLocation="eventoNFeABITiposBasico_v1.00.xsd"/>
	<xs:element name="evPagParcelaNFeABI">
		<xs:annotation>
			<xs:documentation>Schema XML de validação do Evento de Pagamento de Parcela da NF-e ABI</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element name="descEvento">
					<xs:annotation>
						<xs:documentation>Descrição do Evento - “Pagamento de Parcela”</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:whiteSpace value="preserve"/>
							<xs:enumeration value="Pagamento de Parcela"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="cdEventoPag">
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:whiteSpace value="preserve"/>
						<xs:minLength value="2"/>
						<xs:maxLength value="2"/>
						<xs:pattern value="(01|02)"/>
					</xs:restriction>
				</xs:simpleType>				
				</xs:element>
				<xs:element name="vParcela" type="TDec_1302" minOccurs="0"/>
				<xs:element name="vAcrescimos" type="TDec_1302" minOccurs="0"/>
				<xs:element name="vTotalParcela" type="TDec_1302" minOccurs="0"/>
				<xs:element name="vOrigParcela" type="TDec_1302" minOccurs="0"/>
				<xs:element name="vAcrescParcela" type="TDec_1302" minOccurs="0"/>
				<xs:element name="dataPag" type="TData"/>
				<xs:element name="CST" type="TCSTIBSCBS"/>
				<xs:element name="cClassTrib" type="TcClassTribIBSCBS"/>
				<xs:element name="gIBSCBS" type="TGIBSCBSEventoPagParcela"/>
			</xs:sequence>
			<xs:attribute name="versao" type="TVerEvento" use="required"/>
		</xs:complexType>
	</xs:element>
</xs:schema>