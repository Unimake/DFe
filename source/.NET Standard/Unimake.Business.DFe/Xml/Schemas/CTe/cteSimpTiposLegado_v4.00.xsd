											<xs:restriction base="xs:string">
												<xs:enumeration value="1"/>
											</xs:restriction>
										</xs:simpleType>
									</xs:element>
								</xs:sequence>
							</xs:complexType>
						</xs:element>
						<xs:element name="imp">
							<xs:annotation>
								<xs:documentation>Informações relativas aos Impostos</xs:documentation>
							</xs:annotation>
							<xs:complexType>
								<xs:sequence>
									<xs:element name="ICMS" type="TImpCTeSimpLegado">
