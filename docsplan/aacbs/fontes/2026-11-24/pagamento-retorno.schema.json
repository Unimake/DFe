{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PagamentoRetorno",
  "type": "object",
  "additionalProperties": false,
  "required": ["tiqueteSolicitacao", "ni", "niConsumidor", "geradoEm", "apuracao"],
  "properties": {
    "tiqueteSolicitacao": {
      "type": "string",
      "minLength": 1
    },
    "ni": {
      "type": "string",
      "pattern": "^\\d{8}$"
    },
    "niConsumidor": {
      "type": "string",
      "pattern": "^(\\d{11}|\\d{14})$"
    },
    "geradoEm": {
      "type": "string",
      "format": "date-time"
    },
    "apuracao": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["dataArrecadacao", "pagamentos"],
        "properties": {
          "dataArrecadacao": {
            "type": "string",
            "format": "date"
          },
          "pagamentos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                { "$ref": "#/$defs/pagamentoRAD" },
                { "$ref": "#/$defs/pagamentoPCONT" }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "valorMonetario": {
      "type": "number",
      "multipleOf": 0.01
    },
    "composicaoRAD": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequencial", "pa", "vencimento", "principal", "multa", "juros", "total"],
      "properties": {
        "sequencial": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999
        },
        "pa": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])\\/\\d{4}$"
        },
        "vencimento": {
          "type": "string",
          "format": "date-time"
        },
        "niContribuinte": {
          "type": "string",
          "pattern": "^\\d{14}$"
        },
        "chaveDFE": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "principal": { "$ref": "#/$defs/valorMonetario" },
        "multa": { "$ref": "#/$defs/valorMonetario" },
        "juros": { "$ref": "#/$defs/valorMonetario" },
        "total": { "$ref": "#/$defs/valorMonetario" }
      }
    },
    "composicaoPCONT": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequencial", "pa", "vencimento", "principal", "multa", "juros", "total"],
      "properties": {
        "sequencial": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999999
        },
        "pa": {
          "type": "string",
          "pattern": "^(0[1-9]|1[0-2])\\/\\d{4}$"
        },
        "vencimento": {
          "type": "string",
          "format": "date"
        },
        "principal": { "$ref": "#/$defs/valorMonetario" },
        "multa": { "$ref": "#/$defs/valorMonetario" },
        "juros": { "$ref": "#/$defs/valorMonetario" },
        "total": { "$ref": "#/$defs/valorMonetario" }
      }
    },
    "pagamentoRAD": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numeroDARF", "tipo", "niAdquirente", "composicao"],
      "properties": {
        "numeroDARF": {
          "type": "string",
          "pattern": "^\\d{17}$"
        },
        "tipo": {
          "type": "integer",
          "const": 1
        },
        "niAdquirente": {
          "type": "string",
          "pattern": "^\\d{14}$"
        },
        "composicao": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/composicaoRAD" }
        }
      }
    },
    "pagamentoPCONT": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numeroDARF", "tipo", "niContribuinte", "composicao"],
      "properties": {
        "numeroDARF": {
          "type": "string",
          "pattern": "^\\d{17}$"
        },
        "tipo": {
          "type": "integer",
          "const": 2
        },
        "niContribuinte": {
          "type": "string",
          "pattern": "^\\d{14}$"
        },
        "composicao": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/composicaoPCONT" }
        }
      }
    }
  }
}